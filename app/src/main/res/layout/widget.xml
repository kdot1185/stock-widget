<?xml version="1.0" encoding="utf-8"?>
<!-- Card + thin "Updated" strip + list. The card is an image so its color and opacity can change at runtime
     without losing the rounded corners. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/updated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="#FF86868B"
                android:textSize="12dp" />

            <ImageView
                android:id="@+id/refresh"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="-6dp"
                android:contentDescription="Refresh"
                android:padding="7dp"
                android:src="@drawable/ic_refresh"
                android:tint="#FF6E6E73" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/strip_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginEnd="6dp"
            android:background="#FFE8E8ED" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:paddingEnd="6dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Tap to add tickers"
                android:textColor="#FF86868B"
                android:textSize="14dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
